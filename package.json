{
  "name": "hex-tactics",
  "version": "0.1.0",
  "description": "Tactical 1v1 RPG su griglia esagonale. TypeScript + Phaser 3. AI distillata da Deep CFR.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "author": "ValerioDolci",
  "homepage": "https://valeriodolci.github.io/hex-tactics-play/",
  "keywords": [
    "tactical-rpg",
    "hexagonal-grid",
    "phaser",
    "typescript",
    "ai",
    "deep-cfr"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "format": "prettier --write 'src/**/*.{ts,tsx,json,css,html}'"
  },
  "dependencies": {
    "onnxruntime-web": "^1.25.1",
    "phaser": "^3.80.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^1.4.0"
  }
}
